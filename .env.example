# =============================================================================
# DAEMON Core — Konfiguracja serwera LXC (Debian 12, CPU-only)
# Skopiuj do .env i dostosuj do swojego srodowiska.
# =============================================================================

# --- LLM (Ollama na stacji Windows z RTX 3090) ---
# Zmien DAEMON_LLM_MODEL aby przelaczyc model bez dotykania kodu.
# Zmien DAEMON_OLLAMA_URL na IP swojej stacji Windows.
DAEMON_LLM_MODEL=qwen2.5:14b-instruct
DAEMON_OLLAMA_URL=http://192.168.0.100:11434

# --- TTS: Piper ONNX (CPU-only) ---
DAEMON_LANGUAGE=pl
# Opcjonalnie, jesli chcesz inny model niz domyslny:
# DAEMON_PIPER_MODEL_PATH=models/piper/pl_PL-darkman-medium.onnx
# DAEMON_PIPER_CONFIG_PATH=models/piper/pl_PL-darkman-medium.onnx.json

# --- Serwer API ---
# 0.0.0.0 = dostepny w sieci LAN, 127.0.0.1 = tylko lokalnie
DAEMON_API_HOST=0.0.0.0
DAEMON_API_PORT=8000

# --- Tryb debugowania ---
# true wlacza logi DEBUG we wszystkich modulach
DAEMON_DEBUG_MODE=false
